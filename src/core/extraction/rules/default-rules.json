{
  "version": "1.12.0",
  "synonyms": {
    "credibility": [
      "대외신인도",
      "신인도"
    ],
    "management": [
      "경영상태",
      "신용평가등급",
      "신용평가",
      "신용도"
    ],
    "mgmtExclude": [
      "수행실적",
      "실적평가",
      "사업실적",
      "이행실적",
      "용역실적",
      "입찰참가제한",
      "업무정지",
      "부정당",
      "제재"
    ],
    "performance": [
      "수행실적",
      "실적평가",
      "사업실적",
      "이행실적",
      "용역실적"
    ],
    "bonusLabel": [
      "가점",
      "감점",
      "가감점",
      "가․감점",
      "가·감점",
      "가ㆍ감점",
      "가산점",
      "감산점"
    ],
    "quantPerf": [
      "실적",
      "경험",
      "건수"
    ],
    "quantCred": [
      "신인도",
      "가점",
      "감점",
      "가산",
      "감산",
      "제재",
      "부정당",
      "벌점"
    ],
    "quantMgmt": [
      "경영",
      "신용",
      "재무",
      "부채"
    ],
    "evalItemHeader": [
      "평가항목",
      "평가요소",
      "평가부문",
      "평가분야"
    ],
    "qualTableQuant": [
      "정량",
      "신인도",
      "경영",
      "신용",
      "재무",
      "실적",
      "가점",
      "감점"
    ],
    "scoreHeader": [
      "배점",
      "배점한도",
      "점수"
    ],
    "perfAnchor": [
      "유사사업",
      "유사실적",
      "실적인정",
      "수행실적",
      "유사용역",
      "사업실적",
      "이행실적",
      "용역실적",
      "동등실적",
      "유지보수실적",
      "납품실적"
    ]
  },
  "rules": [
    {
      "id": "cred.table",
      "target": "credibilityScore",
      "strategy": "table-score",
      "label": "credibility",
      "scoreHeader": "scoreHeader",
      "weight": 1
    },
    {
      "id": "mgmt.table",
      "target": "managementScore",
      "strategy": "table-score",
      "label": "management",
      "scoreHeader": "scoreHeader",
      "excludeLabel": "mgmtExclude",
      "weight": 1
    },
    {
      "id": "perf.table",
      "target": "performanceScore",
      "strategy": "table-score",
      "label": "performance",
      "scoreHeader": "scoreHeader",
      "excludeLabel": "management",
      "weight": 1
    },
    {
      "id": "cred.inline",
      "target": "credibilityScore",
      "strategy": "inline-score",
      "label": "credibility",
      "maxGap": 20,
      "weight": 0.3
    },
    {
      "id": "mgmt.inline",
      "target": "managementScore",
      "strategy": "inline-score",
      "label": "management",
      "maxGap": 20,
      "excludeLabel": "mgmtExclude",
      "weight": 0.3
    },
    {
      "id": "perf.inline",
      "target": "performanceScore",
      "strategy": "inline-score",
      "label": "performance",
      "maxGap": 20,
      "excludeLabel": "management",
      "weight": 0.3
    },
    {
      "id": "diff.enum",
      "target": "differentialScoring",
      "strategy": "keyword-enum",
      "weight": 1,
      "pattern": "차등점수제?(?:적용(?:여부|유무))?(?:\\([^)]{0,20}\\))?(?:를|을)?[^가-힣]{0,6}(?<v>미적용|적용하지않|적용하지아니|적용안함|비적용|적용제외|해당없|적용대상이아|심사대상이아|대상이아|부여하지않|부여하지아니|적용|부여)(?![/／]|여부|유무|대상여부|대상유무|하지않|하지아니|안함|않|한경우|할경우|하는경우|시(?![킨행스])|닌경우|닌사업|닌때|닐경우|니면|대상이아)",
      "map": {
        "미적용": false,
        "적용하지않": false,
        "적용안함": false,
        "적용제외": false,
        "해당없": false,
        "비적용": false,
        "적용하지아니": false,
        "적용대상이아": false,
        "심사대상이아": false,
        "대상이아": false,
        "부여하지않": false,
        "부여하지아니": false,
        "적용": true,
        "부여": true
      }
    },
    {
      "id": "perf.period",
      "target": "performancePeriod",
      "strategy": "window-regex",
      "weight": 0.8,
      "anchor": "perfAnchor",
      "blocksAfter": 3,
      "valueType": "years",
      "pattern": "(최근|입찰공고일기준|공고일(전일)?기준)?(?<!창업(?:(?!\\d+년)[^.]){0,20})(?<!^[^가-힣]*(?:(?:붙임|서식|별지)[^.]{0,30}|(?:붙임|별지)\\d*(?:서식|양식)\\d{1,2}\\.[^.]{0,30}))(?<!\\d)(?<!(?:하수급(?:인|업체|자)?의?|하도급계약(?:예정)?금액대비)(?:최근)?)(?<!경력(?:사항|기간)(?:은|는|이|이가)?|경력(?:은|는|이)|(?<!수행)경력)(?!\\d{1,2}년(?![^.]{0,40}(?:한하|한함|인정|만작성|만기재|평가|기준|\\d점))(?:(?!(?<!\\d)\\d{1,2}년(?:이내|간|내))[^.]){0,25}(?:기재|작성|요약|제시|\\)증명서))(?<v>\\d{1,2})년(이내|간|내(?!외)|\\((?=[`'’]?\\d{2})|\\([^)]{0,12}기준\\)(?:이내|간|내(?!외)))(?!에?(사업을)?개시|에?창업)"
    },
    {
      "id": "perf.amount",
      "target": "performanceMinAmount",
      "strategy": "window-regex",
      "weight": 0.8,
      "anchor": "perfAnchor",
      "blocksAfter": 3,
      "valueType": "amount",
      "pattern": "(?<!(?:추정가격|예정가격|기초금액)(?:은|는|이|가|의|[:：])?)(?<![\\d.조억만천백])(?<!\\d,)(?<v>(?:\\d{1,3}(?:,\\d{3})+|\\d+(?:\\.\\d+)?)(?:조|억|천만|백만|만|천)?(?:(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:천만|백만|만|천))*원)(?:\\([^)]{0,15}\\))?(?:[/／]건)?이상(?![:：](?:\\d{1,3}(?:,\\d{3})+(?![\\d조억만천원])|\\d+(?!,\\d{3}(?![조억만천원])))(?:\\.\\d+)?(?:점|$|[,/])|\\d+(?:\\.\\d+)?(?:점|$)|[~∼～])"
    },
    {
      "id": "perf.condition",
      "target": "performanceCondition",
      "strategy": "block-capture",
      "weight": 1,
      "anchor": "^[※*＊]?유사(사업|용역|실적)[:：]|실적인정(대상|범위|기준)(?!(은|는)?제안요청서|와|과)|유사(사업|용역)(이란|은|의범위|(인정)?범위[:：]|(의)?정의(?!에|와|가|를|로|하))",
      "stopAt": "^※|^[가-힣]\\.|^\\d+\\.|^□|^○|^-?이행실적에따른배점|^수행실적평가기준|^평가(등급|항목)|^실적등급|^평점",
      "maxBlocks": 6,
      "maxChars": 600,
      "conflictPolicy": "prefer_priority"
    },
    {
      "id": "cred.bonusTable",
      "target": "extras.bonusTable",
      "strategy": "bonus-table",
      "scoreHeader": "scoreHeader",
      "rowLabel": "bonusLabel",
      "weight": 1,
      "conflictPolicy": "prefer_priority"
    },
    {
      "id": "eval.quantTable",
      "target": "extras.quantTable",
      "strategy": "quant-table",
      "scoreHeader": "scoreHeader",
      "title": "정량(?:적)?평가",
      "perfLabel": "quantPerf",
      "credLabel": "quantCred",
      "mgmtLabel": "quantMgmt",
      "docKinds": ["eval_criteria", "notice", "rfp"],
      "weight": 1
    },
    {
      "id": "basic.projectPeriod",
      "target": "extras.projectPeriod",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "anchor": "^(?:[가-힣]\\.)?[^가-힣]{0,8}(?:총|전체)?(?:사업|용역|계약|수행|과업)기간[:)]",
      "pattern": "^(?:[가-힣]\\.)?[^가-힣]{0,8}(?:총|전체)?(?:사업|용역|계약|수행|과업)기간[:)]+(?=[^:]{0,40}(?:\\d{4}[.\\-/년]|\\d{1,3}(?:개월|일|년|주)|계약(?:체결)?일|착수일|협약일|\\d\\.?~|까지))(?![^:]{0,80}년월일)(?![.~∼～\\-/·]*(?:부터)?[.~∼～\\-/·]*(?:까지)?$)(?<v>[^:]{2,80})"
    },
    {
      "id": "eval.methodDoc",
      "target": "extras.evalMethodDoc",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "anchor": "^(?:[가-힣]\\.)?[^가-힣]{0,8}(?:기술)?평가(?:방식|방법)[:)]",
      "pattern": "^(?:[가-힣]\\.)?[^가-힣]{0,8}(?:기술)?평가(?:방식|방법)[:)]+(?!(?:제안요청서|공고문|붙임|별첨|별지|「))(?<v>(?=[^:]{0,60}(?:평가|심사|발표|서면|온라인|소집|PT|협상|제안서))[^:]{4,160})"
    },
    {
      "id": "basic.projectPeriodParen",
      "target": "extras.projectPeriodParen",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "anchor": "\\(총(?:사업|용역|계약|과업)기간:",
      "pattern": "\\(총(?:사업|용역|계약|과업)기간:(?=[^:)]{0,40}(?:\\d{4}[.\\-/년]|\\d{1,3}(?:개월|일|년|주)))(?![^:]{0,80}년월일)(?![.~∼～\\-/·]*(?:부터)?[.~∼～\\-/·]*(?:까지)?$)(?<v>\\d[^:)]{1,78})"
    },
    {
      "id": "basic.projectPeriodCell",
      "target": "extras.projectPeriodCell",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 1,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "anchor": "^(?:[가-힣]\\.)?[^가-힣]{0,8}(?:총|전체)?(?:사업|용역|계약|수행|과업)기간:?$",
      "pattern": "^(?!.*(?:사업|용역|계약|수행|과업)기간)(?=[^:]{0,40}(?:\\d{4}[.\\-/년]|까지|\\d\\.?~|계약(?:체결)?일|착수일|협약일))(?![^:]{0,80}년월일)(?![.~∼～\\-/·]*(?:부터)?[.~∼～\\-/·]*(?:까지)?$)(?<v>[^:]{2,80})$"
    },
    {
      "id": "sched.proposalPeriodDoc",
      "target": "extras.proposalPeriod",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "anchor": "(?:입찰서|제안서|입찰서\\(제안서\\)|기술제안서)제출(?:기간|기한|일시|마감일시|마감일?|마감시간)",
      "pattern": "(?:입찰서|제안서|입찰서\\(제안서\\)|기술제안서)제출(?:기간|기한|일시|마감일시|마감일?|마감시간)(?:\\([^)]{0,15}\\))?[:)]*(?<v>\\d{4}(?:[./\\-]\\d{1,2}[./\\-]|년\\d{1,2}월)\\d{1,2}일?\\.?(?:\\([월화수목금토일]\\))?(?:\\d{1,2}:\\d{2})?(?:[~∼～](?:\\d{4}(?:[./\\-]\\d{1,2}[./\\-]|년\\d{1,2}월)\\d{1,2}일?\\.?(?:\\([월화수목금토일]\\))?(?:\\d{1,2}:\\d{2})?|\\d{1,2}:\\d{2}))?(?:까지)?)"
    },
    {
      "id": "sched.proposalEvalDoc",
      "target": "extras.proposalEvalAt",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "anchor": "(?:제안서평가(?:\\([^)]{0,6}\\))?(?:일시|일자)?|제안서발표(?:일시|일자)?|평가일시(?:및장소)?|(?<!결과|결과의|적격자|선정|합격|합격자|낙찰|낙찰자|대상자)발표일시)",
      "pattern": "(?:제안서평가(?:\\([^)]{0,6}\\))?(?:일시|일자)?|제안서발표(?:일시|일자)?|평가일시(?:및장소)?|(?<!결과|결과의|적격자|선정|합격|합격자|낙찰|낙찰자|대상자)발표일시)[:)]*(?<v>\\d{4}(?:[./\\-]\\d{1,2}[./\\-]|년\\d{1,2}월)\\d{1,2}일?\\.?(?:\\([월화수목금토일]\\))?(?:\\d{1,2}:\\d{2})?)"
    },
    {
      "id": "sched.proposalEvalDocCell",
      "target": "extras.proposalEvalAt",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 1,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "anchor": "^[^가-힣]{0,4}(?:제안서평가(?:\\([^)]{0,6}\\))?(?:일시|일자)|제안서발표(?:일시|일자)|평가일시)[:)]?$",
      "pattern": "^(?<v>\\d{4}(?:[./\\-]\\d{1,2}[./\\-]|년\\d{1,2}월)\\d{1,2}일?\\.?(?:\\([월화수목금토일]\\))?(?:\\d{1,2}:\\d{2})?)"
    },
    {
      "id": "eval.quantDoc",
      "target": "extras.quantEvalDoc",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "anchor": "정량적?평가(?=[:(])|신인도(?:평가관련)?:",
      "pattern": "(?<v>(?![^※]{0,100}(?:확인서|증명서|서식|재무관|수상실적|위탁운영실적|책임자|1부))(?:정량적?평가(?=[:(])(?=.{0,60}?(?:경영상태|신용평가|신인도|수행실적|사업실적|유사.{0,6}실적))[^※]{1,100}|신인도(?:평가관련)?:.{0,12}별표.{0,60}))"
    },
    {
      "id": "eval.qualTable",
      "target": "extras.qualOnlyTable",
      "strategy": "qual-table",
      "scoreHeader": "scoreHeader",
      "itemHeader": "evalItemHeader",
      "quantLabel": "qualTableQuant",
      "docKinds": ["eval_criteria", "notice", "rfp"],
      "weight": 1,
      "conflictPolicy": "prefer_priority"
    },
    {
      "id": "eval.quantMention",
      "target": "extras.quantMention",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "docKinds": ["eval_criteria", "notice", "rfp"],
      "anchor": "정량",
      "pattern": "(?<v>정량[가-힣]{0,6})"
    },
    {
      "id": "eval.perfAggregate",
      "target": "extras.perfAggregate",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "docKinds": ["eval_criteria", "notice", "rfp"],
      "anchor": "대비",
      "pattern": "(?<!하도급[가-힣]{0,8})(?<v>(?:해당)?(?:사업규모|사업금액|추정가격|사업예산|용역금액)대비(?![^.※]{0,80}?(?:단일|1건|최대|공동수급|구성원|지분))[^.※]{0,60}?실적[^.※]{0,20}?(?:합산|누적|합계))"
    },
    {
      "id": "elig.perfPerCase",
      "target": "extras.perfPerCase",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "anchor": "건당|단일|1건|각건|건별|한건",
      "pattern": "(?<!하수급(?:인|업체|자)?의?[가-힣]{0,10})(?<v>(?:건당|단일(?:계약|용역|사업|프로젝트)?건?|1건당|1건|각건|건별|한건)(?:의)?(?:실적|계약|용역|금액|사업|실적규모)?(?:금액|규모)?(?:이|은|는|을|를|가|의)?(?:\\d[\\d,.]*(?:조|억|천만|백만|만|천)?원?|(?:(?:사업|추정|용역)?(?:금액|가격|규모|예산)의?)?(?:\\d+(?:\\.\\d+)?%|\\d+/\\d+|\\d+분의\\d+))이상)"
    },
    {
      "id": "eval.quantNone",
      "target": "extras.quantEvalNone",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "docKinds": ["eval_criteria", "notice", "rfp"],
      "anchor": "정량적?평가(?:기관)?:",
      "pattern": "(?<![가-힣])(?<v>정량적?평가(?:기관)?:(?:없음|미실시|해당없음|해당사항없음|미적용))(?![가-힣]|\\d)"
    },
    {
      "id": "elig.perfRestriction",
      "target": "extras.perfRestriction",
      "strategy": "window-regex",
      "weight": 1,
      "blocksAfter": 0,
      "valueType": "text",
      "conflictPolicy": "prefer_priority",
      "docKinds": ["notice"],
      "anchor": "실적제한|실적(?:이|을|를)?(?:보유|갖춘|있는)",
      "pattern": "(?<!하수급(?:인|업체|자)?의?(?:수행|이행|납품|공급|용역|시공|사업)?)(?<v>실적제한(?!없|을두지|이없|을하지|미적용|해당없)|(?:수행|이행|납품|공급|용역|시공|사업)?실적(?:이|을|를)?(?:보유|갖춘|있는))"
    }
  ]
}
